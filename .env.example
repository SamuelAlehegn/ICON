# Development values for `docker compose` only. Never copy these credentials
# into a deployed environment. Store production secrets in a secret manager.

# Compose host ports
FRONTEND_PORT=8081
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Local PostgreSQL container credentials
DB_NAME=eotcicon
DB_USERNAME=eotcicon
DB_PASSWORD=local-development-change-me

# JWT signing key (HS256 requires at least 32 bytes)
JWT_SECRET=local-compose-only-change-this-secret-before-deployment
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000

# The frontend is served through Nginx; this origin is for direct API access.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# Used by the backend when running outside Compose with the `local` H2 profile.
# Leave unset to use an in-memory database.
# H2_URL=jdbc:h2:file:./data/eotcicon;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH

# Required when running the `prod` profile outside Compose:
# DB_URL=jdbc:postgresql://db-host:5432/eotcicon
# STORAGE_LOCAL_ROOT=/var/lib/eotcicon/media
