# ---------------------------------------------------------------------------
# EOTC Sacred Icons Archive — environment variables.
#
#   cp .env.example .env
#
# Every value below has a working default in docker-compose.yml, so the stack
# starts with `docker compose up --build` even without a .env file. Copy this
# file to .env to override any of them.
#
# .env holds local secrets only — never commit it (it is git-ignored).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Host ports (read by Docker Compose)
# ---------------------------------------------------------------------------
FRONTEND_PORT=8081
BACKEND_PORT=8080
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# 2. PostgreSQL (read by Docker Compose and by the backend)
#
#    The `docker` and `prod` profiles read DB_URL / DB_USERNAME / DB_PASSWORD
#    and refuse to start without them. DB_URL is built from DB_NAME so the
#    compose database and the backend always agree.
# ---------------------------------------------------------------------------
DB_NAME=eotcicon
DB_USERNAME=eotcicon
DB_PASSWORD=eotcicon
# Only needed when running the backend outside Compose, e.g. against a
# database on your host machine:
# DB_URL=jdbc:postgresql://localhost:5432/eotcicon

# ---------------------------------------------------------------------------
# 3. MinIO / object storage (read by Docker Compose and by the backend)
#
#    The backend reaches MinIO over the compose network; browsers use
#    STORAGE_PUBLIC_BASE_URL, which points at the published host port.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=eotc-media
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/eotc-media
STORAGE_LOCAL_ROOT=./data/media

# ---------------------------------------------------------------------------
# 4. Backend profiles
#
#    local  (default) -> H2, no Docker required
#    docker          -> PostgreSQL (Docker Compose)
#    prod            -> PostgreSQL (production)
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker
# Server port of the backend (8080 by default).
SERVER_PORT=8080
# JDBC URL for a file-based H2 database in the `local` profile. Leave unset
# for the in-memory database (data is discarded on shutdown).
# H2_URL=jdbc:h2:file:./data/eotcicon;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH

# ---------------------------------------------------------------------------
# 5. Reserved — not read by the backend yet
#
#    These belong to features that are still to be implemented (JWT auth,
#    CORS, bootstrap accounts, upload limits, rate limiting). They are listed
#    here so the target configuration surface is known; setting them has no
#    effect until the matching backend code lands.
# ---------------------------------------------------------------------------
# JWT_SECRET=
# JWT_ACCESS_TTL=PT15M
# JWT_REFRESH_TTL=P30D
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
# UPLOAD_MAX_BYTES=15728640
# RATE_LIMIT_CONTRIBUTE_CAPACITY=5
# RATE_LIMIT_CONTRIBUTE_REFILL_MINUTES=60
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# MODERATOR_EMAIL=
# MODERATOR_PASSWORD=
# SEED_SAMPLE_DATA=false
